{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "santregy",
	"compatibility_date": "2024-11-01",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"main": "./worker/index.ts",
	"assets": {
		"directory": "./dist/client",
		"binding": "ASSETS",
		"not_found_handling": "single-page-application"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "santregy",
			"database_id": "d1ecce49-35e8-4fdc-b11d-9c553eb3ab3d",
			"migrations_dir": "migrations"
		}
	],
	"triggers": {
		// Daily at 13:00 UTC (~9am US/Eastern, after prior US market close, well before next open).
		"crons": [
			"0 13 * * *"
		]
	},
	"vars": {
		// Base URL used to build magic-link URLs in emails. Override per environment.
		"APP_BASE_URL": "https://santregy.topephysics.workers.dev"
	}
}